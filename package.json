{
  "name": "@tailor-cms/ce-jodit-html",
  "description": "Tailor CMS Jodit HTML editor",
  "author": "Studion <info@gostudion.com> (https://github.com/tailor-cms)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "pnpm boot:cek",
    "boot:cek": "cd ./node_modules/@tailor-cms/tce-boot && pnpm start --default-display",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint && eslint .",
    "lint:fix": "pnpm -r run lint --fix && eslint . --fix",
    "nuke:dist": "pnpm -r run nuke:dist",
    "nuke": "pnpm -r run nuke && pnpm dlx del-cli node_modules",
    "test": "pnpm playwright test --config ./test/playwright.config.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.64.0",
    "@tailor-cms/cek-e2e": "3.0.0",
    "@tailor-cms/eslint-config": "3.0.0",
    "@tailor-cms/tce-boot": "3.0.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=26"
  }
}
