{
  "name": "@tailor-cms/ce-jodit-html-display",
  "description": "Tailor CMS Jodit HTML editor end-user component",
  "author": "Studion <info@gostudion.com> (https://github.com/tailor-cms)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tailor-cms/ce-jodit-html.git",
    "directory": "packages/display"
  },
  "homepage": "https://github.com/tailor-cms/ce-jodit-html#readme",
  "bugs": "https://github.com/tailor-cms/ce-jodit-html/issues",
  "type": "module",
  "version": "2.1.0",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm nuke:dist && vue-tsc && vite build",
    "lint": "eslint ./src",
    "lint:fix": "pnpm lint --fix",
    "nuke": "pnpm dlx del-cli dist node_modules",
    "nuke:dist": "pnpm dlx del-cli dist",
    "prepublish": "pnpm build"
  },
  "peerDependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@tailor-cms/ce-jodit-html-manifest": "workspace:*",
    "@tailor-cms/eslint-config": "2.3.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue-tsc": "^3.3.12",
    "vuetify": "^4.2.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  }
}
